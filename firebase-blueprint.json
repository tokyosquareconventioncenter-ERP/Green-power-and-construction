{
  "entities": {
    "CompanySetting": {
      "title": "Company Setting",
      "description": "Company name settings",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Company name"
        }
      },
      "required": ["name"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with role",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["owner", "foreman"]
        }
      },
      "required": ["name", "role"]
    },
    "Site": {
      "title": "Construction Site",
      "description": "Work site managed by contractor",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["name"]
    },
    "Worker": {
      "title": "Worker Profile",
      "description": "Electrical worker profile",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["ইলেকট্রিশিয়ান", "ফোরম্যান", "হেল্পার"]
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["name", "role"]
    },
    "WorkerFinance": {
      "title": "Worker Financial Record",
      "description": "Worker wage, advance, paid, and override settings",
      "type": "object",
      "properties": {
        "rate": {
          "type": "number",
          "description": "Daily wage rate in BDT"
        },
        "prevDue": {
          "type": "number",
          "description": "Previous dues BDT"
        },
        "advance": {
          "type": "number",
          "description": "Advance paid BDT"
        },
        "paid": {
          "type": "number",
          "description": "Salary paid BDT"
        },
        "manualDays": {
          "type": "number",
          "description": "Manual override for present days count"
        },
        "manualPayable": {
          "type": "number",
          "description": "Manual override for total payable wage"
        }
      }
    },
    "Attendance": {
      "title": "Attendance Record",
      "description": "Daily attendance doc for a worker",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "workerId": {
          "type": "string"
        },
        "workerName": {
          "type": "string"
        },
        "siteId": {
          "type": "string"
        },
        "siteName": {
          "type": "string"
        },
        "present": {
          "type": "number",
          "enum": [0, 1]
        },
        "overtime": {
          "type": "number"
        },
        "taken": {
          "type": "number"
        }
      },
      "required": ["date", "workerId", "siteId", "present"]
    },
    "Income": {
      "title": "Income Entry",
      "description": "Site income or advance payment received",
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "siteId": {
          "type": "string"
        },
        "siteName": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["date", "siteId", "amount"]
    },
    "Expense": {
      "title": "Daily Expense Entry",
      "description": "Non-wage site expenses",
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "siteId": {
          "type": "string"
        },
        "siteName": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": ["মালামাল", "যাতায়াত", "খাওয়া-দাওয়া", "ভাড়া/মেশিন", "অন্যান্য"]
        },
        "amount": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["date", "siteId", "category", "amount"]
    }
  },
  "firestore": {
    "settings/company": {
      "schema": "CompanySetting",
      "description": "Company metadata and title"
    },
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered app user roles"
    },
    "sites/{siteId}": {
      "schema": "Site",
      "description": "Contractor work sites"
    },
    "workers/{workerId}": {
      "schema": "Worker",
      "description": "Worker details"
    },
    "workerFinance/{workerId}": {
      "schema": "WorkerFinance",
      "description": "Sensitive financial rate, advance, dues per worker"
    },
    "attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Daily attendance entries"
    },
    "income/{incomeId}": {
      "schema": "Income",
      "description": "Contractor income receipts"
    },
    "expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Site operational daily expenses"
    }
  }
}
